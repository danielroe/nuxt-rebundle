{
  "name": "nuxt-rebundle",
  "version": "0.0.2",
  "license": "MIT",
  "description": "Bundler optimisations for Nuxt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielroe/nuxt-rebundle.git"
  },
  "keywords": [
    "nuxt",
    "module",
    "nuxt-module",
    "performance",
    "lighthouse",
    "bundling"
  ],
  "author": {
    "name": "Daniel Roe <daniel@roe.dev>",
    "url": "https://github.com/danielroe"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "import": "./dist/module.mjs",
      "require": "./dist/module.cjs"
    }
  },
  "main": "./dist/module.cjs",
  "types": "./dist/types.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm dev:prepare && nuxt-module-build build",
    "dev": "nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:v5": "pnpm --filter nuxt-rebundle-playground-v5 dev",
    "dev:v5:build": "pnpm --filter nuxt-rebundle-playground-v5 build",
    "dev:prepare": "pnpm nuxt-module-build build --stub && pnpm nuxt-module-build prepare && nuxt prepare playground && pnpm --filter nuxt-rebundle-playground-v5 exec nuxt prepare",
    "lint": "eslint .",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm lint && pnpm test",
    "release": "bumpp && pnpm publish",
    "test": "vitest run",
    "test:types": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/kit": "^4.6.0",
    "acorn": "^8.13.0",
    "estree-walker": "^3.0.3",
    "magic-string": "^1.0.0",
    "mlly": "^1.7.2",
    "pathe": "^2.0.0"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "1.17.0",
    "@nuxt/module-builder": "1.0.3",
    "@nuxt/schema": "4.6.2",
    "@nuxt/test-utils": "4.3.4",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/test-utils": "2.5.1",
    "bumpp": "12.3.0",
    "eslint": "10.13.0",
    "nuxt": "4.6.2",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vitest-environment-nuxt": "2.0.0",
    "vue": "3.5.44",
    "vue-tsc": "3.3.13"
  },
  "peerDependencies": {
    "nuxt": ">=3.12.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  }
}
